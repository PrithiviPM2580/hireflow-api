{
	"name": "hireflow-api",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"type-check": "tsc --noEmit",
		"build": "tsc --build tsconfig.build.json",
		"format": "biome format --write",
		"lint": "biome lint",
		"lint:fix": "biome lint --write",
		"check": "biome check",
		"check:fix": "biome check --write",
		"prepare": "husky",
		"test": "vitest",
		"test:run": "vitest run"
	},
	"lint-staged": {
		"*.{js,ts,json,md,jsonc}": "biome check --write"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
