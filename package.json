		"@types/cors": "^2.8.19",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/morgan": "^1.9.10",
		"@types/multer": "^2.2.0",
		"@types/nodemailer": "^8.0.1",
		"@types/passport": "^1.0.17",
		"@types/passport-google-oauth20": "^2.0.17",
		"@types/supertest": "^7.2.1",
		"@types/swagger-ui-express": "^4.1.8",
		"chalk": "^6.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.0",
		"mongodb-memory-server": "^11.2.0",
		"supertest": "^7.2.2",
		"tsx": "^4.23.13",
